<!doctype html>
<html lang="en">
<head>
  <title><%= event.title %> — Keepsora</title>
  <%- include('partials/head') %>
</head>
<body data-event-slug="<%= event.slug %>">
  <%- include('partials/nav') %>
  <% if (event.cover_photo) { %>
    <div class="event-banner">
      <img src="/uploads/<%= event.slug %>/<%= event.cover_photo %>" alt="<%= event.title %>">
    </div>
  <% } %>
  <main class="page">
    <div class="page-head">
      <div>
        <h1><%= event.title %></h1>
        <p class="muted"><%= event.event_date || '' %></p>
      </div>
    </div>

    <div class="card selfie-card">
      <div class="selfie-card-inner">
        <div class="selfie-avatar" id="selfieAvatar">
          <span class="selfie-avatar-icon lottie-icon lottie-icon-lg" data-lottie="camera"></span>
          <img id="selfiePreview" hidden>
          <span class="selfie-spinner" id="selfieSpinner" hidden></span>
        </div>
        <div class="selfie-copy">
          <p class="label">Find your photos</p>
          <p class="muted small">Take or upload a selfie. Matching happens right here in your browser — your selfie is never uploaded anywhere.</p>
          <p class="selfie-status" id="matchStatus">Loading face recognition models…</p>
          <div class="selfie-actions">
            <button type="button" class="btn btn-lg selfie-cta" id="openCameraBtn"><span class="lottie-icon lottie-icon-sm" data-lottie="camera"></span>Take or upload a selfie</button>
            <input type="file" id="selfieInput" accept="image/*" hidden>
            <button class="btn btn-ghost" id="clearMatchBtn" hidden>Show all photos instead</button>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="grid-head">
        <p class="label" id="gridLabel">All photos</p>
        <button type="button" class="btn btn-sm btn-ghost" id="selectModeBtn">Select photos</button>
      </div>
      <div class="photo-grid" id="photoGrid"></div>
    </div>

    <div class="selection-bar" id="selectionBar" hidden>
      <span id="selectionCount">0 selected</span>
      <div class="selection-actions">
        <button type="button" class="btn btn-sm btn-ghost" id="selectAllBtn">Select all</button>
        <button type="button" class="btn btn-sm" id="downloadSelectedBtn">Download selected</button>
        <button type="button" class="btn btn-sm btn-ghost" id="cancelSelectBtn">Cancel</button>
      </div>
    </div>

    <p class="muted small report-link-row">
      <button type="button" class="link-btn" id="reportToggleBtn"><span class="lottie-icon lottie-icon-sm" data-lottie="flag"></span>Report this gallery</button>
    </p>
    <form id="reportForm" class="card report-form" hidden>
      <p class="label">Report this gallery</p>
      <label>Reason
        <select name="reason" id="reportReason">
          <option value="no_consent">Someone's photo is here without their consent</option>
          <option value="inappropriate">Inappropriate or illegal content</option>
          <option value="spam_or_scam">Spam or a scam</option>
          <option value="other">Other</option>
        </select>
      </label>
      <label>Details (optional)<textarea name="details" id="reportDetails" rows="3" maxlength="1000"></textarea></label>
      <div class="report-form-actions">
        <button type="submit" class="btn btn-sm">Send report</button>
        <button type="button" class="btn btn-sm btn-ghost" id="reportCancelBtn">Cancel</button>
      </div>
      <p class="muted small" id="reportStatus"></p>
    </form>
  </main>

  <div class="camera-modal" id="cameraModal" hidden>
    <button class="camera-close" id="cameraCloseBtn" aria-label="Close camera">✕</button>
    <div class="camera-modal-inner">
      <div class="camera-viewport">
        <video id="cameraVideo" autoplay playsinline muted></video>
        <div class="camera-guide"><div class="camera-guide-oval"></div></div>
      </div>
      <p class="camera-hint">Stand straight, center your face in the oval, and make sure you're well lit.</p>
      <p class="camera-error" id="cameraError" hidden></p>
      <div class="camera-actions">
        <button type="button" class="camera-shutter" id="captureBtn" aria-label="Capture selfie"></button>
      </div>
      <button type="button" class="link-btn camera-upload-instead" id="uploadInsteadBtn">Or upload a photo instead</button>
    </div>
  </div>
  <canvas id="cameraCanvas" hidden></canvas>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" id="lightboxClose">✕</button>
    <img id="lightboxImg">
    <a id="lightboxDownload" class="btn" download>Download</a>
  </div>

  <script src="/vendor/face-api.min.js"></script>
  <script src="/vendor/lottie.min.js"></script>
  <script src="/js/lottie-icons.js"></script>
  <script src="/js/match.js"></script>
</body>
</html>
